import React from "react";
import { listPackages } from "../../api/packages";
import { listChannels } from "../../api/live";
import { listPackageChannels, updatePackageChannels } from "../../api/packageChannels";
import type { Package } from "../../api/packages";
import type { LiveChannel } from "../../api/types";
import { useToast } from "../../components/Toast";

export default function PackageChannelsPage() {
  const toast = useToast();

  const [packages, setPackages] = React.useState<Package[]>([]);
  const [channels, setChannels] = React.useState<LiveChannel[]>([]);
  const [packageId, setPackageId] = React.useState<number | "">("");
  const [selected, setSelected] = React.useState<Set<number>>(new Set());
  const [loading, setLoading] = React.useState(false);
  const [saving, setSaving] = React.useState(false);
  const [q, setQ] = React.useState("");

  React.useEffect(() => {
    (async () => {
      try {
        const [pkgs, chs] = await Promise.all([listPackages(), listChannels()]);
        setPackages(pkgs);
        setChannels(chs);
      } catch (e: any) {
        toast.push({ type: "error", title: "Load failed", message: e?.message || String(e) });
      }
    })();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  async function loadPackageChannels(pid: number) {
    setLoading(true);
    try {
      const items = await listPackageChannels(pid);
      setSelected(new Set(items.map((i) => i.channel_id)));
    } catch (e: any) {
      toast.push({ type: "error", title: "Load failed", message: e?.message || String(e) });
      setSelected(new Set());
    } finally {
      setLoading(false);
    }
  }

  function toggle(id: number) {
    setSelected((prev) => {
      const n = new Set(prev);
      if (n.has(id)) n.delete(id);
      else n.add(id);
      return n;
    });
  }

  function selectAllVisible(visibleIds: number[]) {
    setSelected((prev) => {
      const n = new Set(prev);
      for (const id of visibleIds) n.add(id);
      return n;
    });
  }

  function clearAllVisible(visibleIds: number[]) {
    setSelected((prev) => {
      const n = new Set(prev);
      for (const id of visibleIds) n.delete(id);
      return n;
    });
  }

  async function save() {
    if (!packageId) return;
    setSaving(true);
    try {
      const ids = Array.from(selected.values()).sort((a, b) => a - b);
      await updatePackageChannels(packageId, ids);
      toast.push({ type: "ok", title: "Package channels updated" });
    } catch (e: any) {
      toast.push({ type: "error", title: "Save failed", message: e?.message || String(e) });
    } finally {
      setSaving(false);
    }
  }

  const visible = React.useMemo(() => {
    const term = q.trim().toLowerCase();
    const base = [...channels].sort((a, b) => (a.number ?? 0) - (b.number ?? 0));
    if (!term) return base;
    return base.filter((c) => {
      const hay = `${c.number} ${c.name} ${c.channel_key}`.toLowerCase();
      return hay.includes(term);
    });
  }, [channels, q]);

  const visibleIds = React.useMemo(() => visible.map((c) => c.id), [visible]);

  return (
    <div className="container">
      <div className="row" style={{ marginBottom: 14 }}>
        <p className="h1" style={{ margin: 0 }}>
          Package Channels
        </p>

        <div className="spacer" />

        <input
          className="input"
          style={{ width: 320 }}
          placeholder="Search channels…"
          value={q}
          onChange={(e) => setQ(e.target.value)}
          disabled={!packageId}
        />

        <select
          className="select"
          value={packageId}
          onChange={(e) => {
            const v = e.target.value;
            if (!v) {
              setPackageId("");
              setSelected(new Set());
              return;
            }
            const pid = Number(v);
            setPackageId(pid);
            loadPackageChannels(pid);
          }}
          style={{ minWidth: 240 }}
        >
          <option value="">Select package…</option>
          {packages.map((p) => (
            <option key={p.id} value={p.id}>
              {p.name} ({p.status})
            </option>
          ))}
        </select>

        <button className="btn" onClick={() => packageId && loadPackageChannels(packageId)} disabled={!packageId || loading}>
          Refresh
        </button>

        <button className="btn primary" onClick={save} disabled={!packageId || saving || loading}>
          {saving ? "Saving…" : "Save"}
        </button>
      </div>

      {!packageId ? (
        <div className="card muted">Select a package to manage its channels.</div>
      ) : (
        <div className="card">
          <div className="row" style={{ marginBottom: 10 }}>
            <span className="badge">{loading ? "Loading…" : `${selected.size} selected`}</span>
            <div className="spacer" />
            <button className="btn small" onClick={() => selectAllVisible(visibleIds)} disabled={loading || saving}>
              Select visible
            </button>
            <button className="btn small" onClick={() => clearAllVisible(visibleIds)} disabled={loading || saving}>
              Clear visible
            </button>
          </div>

          <table className="table">
            <thead>
              <tr>
                <th style={{ width: 56 }} />
                <th style={{ width: 90 }}>No.</th>
                <th>Name</th>
                <th style={{ width: 140 }}>Key</th>
                <th style={{ width: 110 }}>Enabled</th>
              </tr>
            </thead>
            <tbody>
              {visible.map((c) => (
                <tr key={c.id}>
                  <td style={{ width: 56 }}>
                    <input
                      type="checkbox"
                      checked={selected.has(c.id)}
                      onChange={() => toggle(c.id)}
                      disabled={loading || saving}
                    />
                  </td>
                  <td style={{ width: 90 }}>
                    <b>{c.number}</b>
                  </td>
                  <td>{c.name}</td>
                  <td style={{ width: 140, fontFamily: "monospace" }}>{c.channel_key}</td>
                  <td style={{ width: 110 }}>{c.enabled ? "yes" : "no"}</td>
                </tr>
              ))}

              {!loading && visible.length === 0 ? (
                <tr>
                  <td colSpan={5} className="muted">
                    No channels found.
                  </td>
                </tr>
              ) : null}
            </tbody>
          </table>
        </div>
      )}
    </div>
  );
}
