###############################################################################
# DATABASE (MariaDB) — UNIX SOCKET
###############################################################################

DB_NAME=starstream
DB_USER=quad
DB_PASS=quad514562a

# Use socket; when set, Db::pdo() will ignore DB_HOST/DB_PORT
DB_SOCKET=/run/mysqld/mysqld.sock

# Optional (ignored when DB_SOCKET is set, but keep for clarity)
DB_HOST=127.0.0.1
DB_PORT=3306

###############################################################################
# MANAGEMENT API
###############################################################################
MGMT_API_PORT=8100
MGMT_SESSION_TTL=86400
MGMT_COOKIE_SECURE=0

###############################################################################
# LOGGING / APP
###############################################################################
APP_ENV=production
APP_NAME=StarStream-Management
LOG_LEVEL=info
LOG_CHANNEL=management

# -------------------------
# FILE STORAGE (LOGOS)
# -------------------------
CHANNEL_LOGO_DISK_BASE=/opt/starstream/assets/channels/logos
CHANNEL_LOGO_MAX_BYTES=2097152
CHANNEL_LOGO_MAX_W=4096
CHANNEL_LOGO_MAX_H=4096
CHANNEL_LOGO_SIZE=256\nCHANNEL_LOGO_URL_PREFIX=/assets/channels/logos
